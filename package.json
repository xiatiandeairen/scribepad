{
  "name": "scribepad",
  "version": "0.2.0",
  "type": "module",
  "description": "Local-first Markdown review gate for AI coding plans.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiatiandeairen/scribepad.git"
  },
  "homepage": "https://github.com/xiatiandeairen/scribepad#readme",
  "bugs": {
    "url": "https://github.com/xiatiandeairen/scribepad/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "scribepad": "./dist/server/index.js"
  },
  "scripts": {
    "dev": "npm run dev:server",
    "dev:server": "PORT=3001 tsx watch --include types --include server server/index.ts tests/fixtures/plan-light.md",
    "build": "rm -rf dist && tsc -p tsconfig.server.json",
    "prepare": "npm run build",
    "start": "NODE_ENV=production node dist/server/index.js",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:session": "npm run build && playwright test --config=playwright.session.config.ts tests/e2e/session-server.spec.ts",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.core.json --noEmit"
  },
  "files": [
    "dist",
    "client-next",
    "README.md",
    "docs/assets/scribepad-review-demo.gif"
  ],
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "execa": "^9.6.1",
    "hono": "^4.6.14",
    "mdast-util-from-markdown": "^2.0.1",
    "mdast-util-gfm": "^3.1.0",
    "micromark-extension-gfm": "^3.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.9.0",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "playwright": "^1.49.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0",
    "vitest": "^2.1.5"
  }
}
